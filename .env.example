# SpeedyBot configuration example
# Maintainer: SudoShayanNA
# Repository: https://github.com/roseshayan/SpeedyBot

export BOT_TOKEN='YOUR_TELEGRAM_BOT_TOKEN'
export ADMIN_ID='YOUR_NUMERIC_TELEGRAM_ID'
export XUI_API_URL='https://panel.example.com:2053'
export XUI_BASE_PATH='/your-web-base-path'
export XUI_BEARER_TOKEN='YOUR_3XUI_API_TOKEN'
export XUI_SUB_SERVER_URL='https://sub.example.com:2096'
export XUI_SUB_PATH='/sub/'

# Never put real production values in this example file.
# The installer writes the real runtime values to /root/SpeedyBot/.env.
